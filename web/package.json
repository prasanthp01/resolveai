{
  "name": "resolveai-web",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && npm run studio && npm run simulation && npm run diagrams && vite build && vite build --config vite.widget.config.ts && node scripts/check-widget.mjs",
    "typecheck": "tsc --noEmit",
    "diagrams": "node scripts/check-diagrams.mjs && node scripts/check-diagram-compiler.mjs && node scripts/check-diagram-assets.mjs",
    "simulation": "node scripts/check-simulation.mjs",
    "studio": "node scripts/check-studio.mjs",
    "diagrams:generate": "node scripts/generate-diagram-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "mermaid": "^11.0.0"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
