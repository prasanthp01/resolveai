DB_PASSWORD=replace-with-random-password
DATABASE_URL=postgresql+asyncpg://resolveai_app:replace-with-random-password@127.0.0.1:55433/resolveai
DEMO_MODE=true
PUBLIC_ORIGIN=http://localhost:8130
COOKIE_SECURE=false
CONNECTOR_KEY=
ALLOWED_CONNECTOR_NETWORKS=
LLM_ENABLED=false
LLM_API_KEY=
LLM_MODEL=

# Optional private route migration. Keep default values until staged prefix tests pass.
API_PREFIX=/api/v1
COOKIE_PATH=/
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
# AgentOps currently supports synthetic routing only; live requests fail safely.
AGENTOPS_URL=
AGENTOPS_TOKEN=
AGENTOPS_POLICY_VERSION=policy-2026-10-v1
AGENTOPS_ENVIRONMENT=staging
